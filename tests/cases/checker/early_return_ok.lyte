// Well-typed early returns, in a value-returning function and in a lambda.
// expected stdout:
// compilation successful
// 0
// 1
// 5
// 3

clamp01(x: i32) -> i32 {
    if x < 0 { return 0 }
    if x > 1 { return 1 }
    x
}

main() {
    print(clamp01(-4))
    print(clamp01(7))
    print(clamp01(5) + 4)
    let f = |x: i32| { return x + 1 }
    print(f(2))
}
